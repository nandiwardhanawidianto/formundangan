{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "royal/form-undangan",
  "type": "project",
  "description": "Sistem pengisian data undangan Royal Wedding Invitation",
  "keywords": ["laravel", "wedding", "invitation"],
  "license": "proprietary",
  "require": {"php": "^8.2", "laravel/framework": "^12.0", "laravel/tinker": "^2.10.1"},
  "require-dev": {"fakerphp/faker": "^1.24", "laravel/pail": "^1.2.2", "laravel/pint": "^1.13", "laravel/sail": "^1.41", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.6", "phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""], "post-create-project-cmd": ["@php artisan key:generate --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true, "php-http/discovery": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
